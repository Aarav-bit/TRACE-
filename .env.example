# TRACE Configuration

# Server ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database
DATABASE_URL=sqlite:///./trace.db

# Storage & Upload Limits
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB
MAX_FILES_PER_UPLOAD=10

# Autonomous Investigation Safety Limits
MAX_INVESTIGATION_STEPS=12
TOOL_TIMEOUT_SECONDS=15
MAX_TOOL_OUTPUT_BYTES=1000000
MAX_RETRY_COUNT=2
MAX_EXTRACTION_SIZE_BYTES=104857600

# Agent / LLM Configuration
# Modes: "deterministic" (no key required, default offline mode) | "ai"
LLM_PROVIDER=deterministic
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# External Forensic Tools (Optional - detected automatically if on PATH)
# AUTOPSY_PATH=C:\Program Files\Autopsy\bin\autopsy64.exe
# TSK_BIN_DIR=C:\tools\sleuthkit\bin
# EVIDENCE_WORK_DIR=./data/storage/work
