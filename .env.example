# TRACE Configuration

# Server ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database
DATABASE_URL=sqlite:///./trace.db

# Storage & Upload Limits
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB
MAX_FILES_PER_UPLOAD=10

# Autonomous Investigation Safety Limits
MAX_INVESTIGATION_STEPS=15
TOOL_TIMEOUT_SECONDS=15
MAX_RETRY_COUNT=2

# Agent / LLM Configuration
# Modes: "deterministic" (no key required, default offline mode) | "gemini" | "openai"
LLM_PROVIDER=deterministic
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# External Forensic Tools (Optional - detected automatically if on PATH)
# AUTOPSY_PATH=C:\Program Files\Autopsy\bin\autopsy64.exe
# TSK_PATH=C:\tools\sleuthkit\bin
# VOLATILITY_PATH=
